# Sarvam AI Secrets
SARVAM_API_KEY=your_sarvam_api_key_here
USE_MOCK_SARVAM=false

# Server Configuration
PORT=4000
NODE_ENV=production
BASE_URL=https://your-production-domain.com

# Security Tokens (Generate secure 32+ char random strings)
JWT_SECRET=replace_with_a_secure_random_string_32_chars
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_32_chars

# Tunable Business Constants (PRD Section 5.1 & Section 22.1)
OCR_LOW_CONFIDENCE_RATIO_THRESHOLD=0.34
STORAGE_DIR=./data/storage
